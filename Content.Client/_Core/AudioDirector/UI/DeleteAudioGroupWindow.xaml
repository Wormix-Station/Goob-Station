<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="Delete Audio Group"
    SetWidth="380"
    SetHeight="180">

    <BoxContainer
        Orientation="Vertical"
        SeparationOverride="10">

        <Label
            Name="ConfirmationLabel"
            Text="Delete this audio group?"
            HorizontalAlignment="Center"
            HorizontalExpand="True" />

        <BoxContainer
            Orientation="Horizontal"
            SeparationOverride="8"
            HorizontalAlignment="Center">

            <Button
                Name="CancelButton"
                Text="Cancel"
                MinWidth="110" />

            <Button
                Name="DeleteButton"
                Text="Delete"
                MinWidth="110"
                StyleClasses="negative" />

        </BoxContainer>

    </BoxContainer>

</DefaultWindow>
