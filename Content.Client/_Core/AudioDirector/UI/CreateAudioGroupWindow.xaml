<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="Create Audio Group"
    SetWidth="420"
    SetHeight="380">

    <BoxContainer
        Orientation="Vertical"
        SeparationOverride="8">

        <Label Text="Group name:" />

        <LineEdit
            Name="GroupNameEdit"
            PlaceHolder="Enter group name"
            HorizontalExpand="True" />

        <Label Text="Target type:" />

        <OptionButton
            Name="TargetTypeOption"
            HorizontalExpand="True" />

        <BoxContainer
            Name="GridTargetEditor"
            Orientation="Vertical"
            SeparationOverride="4">

            <Label Text="Enter Grid UID:" />

            <LineEdit
                Name="GridUidEdit"
                PlaceHolder="Example: 123"
                HorizontalExpand="True" />

        </BoxContainer>

        <BoxContainer
            Name="MapTargetEditor"
            Orientation="Vertical"
            SeparationOverride="4"
            Visible="False">

            <Label Text="Enter Map ID:" />

            <LineEdit
                Name="MapIdEdit"
                PlaceHolder="Example: 1"
                HorizontalExpand="True" />

        </BoxContainer>

        <BoxContainer
            Name="PlayersTargetEditor"
            Orientation="Vertical"
            SeparationOverride="4"
            Visible="False">

            <Label Text="Select players:" />

            <ScrollContainer
                VerticalExpand="True"
                MinHeight="140">

                <BoxContainer
                    Name="PlayersList"
                    Orientation="Vertical"
                    SeparationOverride="4" />

            </ScrollContainer>

        </BoxContainer>

        <Label
            Name="ErrorLabel"
            Text=""
            Visible="False"
            HorizontalAlignment="Center" />

        <Button
            Name="CreateButton"
            Text="Create"
            Disabled="True"
            HorizontalExpand="True" />

    </BoxContainer>

</DefaultWindow>
